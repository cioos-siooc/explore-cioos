# Coolify environment variables — TEST/STAGING template.
#
# Paste this into the Coolify resource's Environment Variables (use the
# "Developer view" to paste the whole block). Coolify deploys the base
# docker-compose.yaml only (no override, no host ports) and injects the
# SERVICE_FQDN_NGINX_4000 / SERVICE_URL_NGINX magic variables itself — do NOT
# set those here.
#
# The harvest config arrives via HARVEST_CONFIG_B64 below (the image bakes no
# config and repo-file bind mounts don't work under Coolify). Edit the YAML file
# in the repo, re-encode it, paste the new one-liner, and REDEPLOY the resource
# to apply — a container restart reuses the old environment.

# --- Database (internal to the compose stack) ---
DB_NAME=cde
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_HOST=db
DB_HOST_EXTERNAL=db
REDIS_HOST=redis

# --- API / frontend ---
# Public URL of this Coolify resource (nginx FQDN Coolify assigns) + /api.
# Used as a frontend BUILD argument, so changing it requires a rebuild.
API_URL=https://CHANGE-ME.example.coolify/api
BASE_URL=/
CORS_ORIGINS=*
ENABLE_API_DOCS=true

# --- Download scheduler ---
# SERVICE_URL_NGINX (injected by Coolify) already provides the download WAF
# base; DOWNLOAD_WAF_URL is the non-Coolify fallback and can stay unset.
CREATE_PDF=False
DOWNLOADS_FOLDER=./downloads
# GMAIL_USER=
# GMAIL_PASSWORD=

# --- Observability ---
ENVIRONMENT=staging
SENTRY_DSN=

# --- Prefect worker / harvest triggers ---
# No cron while testing — trigger harvests manually from the Prefect UI or the
# dashboard. Set e.g. "0 0 */3 * *" when ready for a schedule (applies on redeploy).
HARVESTER_CRON=
VERNACULARS_CRON=
# Leave false so a config-only redeploy doesn't kick off a harvest.
RUN_ON_DEPLOY=false
REGISTER_DEPLOYMENTS=true
INCREMENTAL_MODE=true

# --- Harvest dashboard ---
# External Prefect UI base URL for "View in Prefect" links.
PREFECT_UI_URL=https://CHANGE-ME-prefect.example.coolify
HARVEST_TRIGGER_ENABLED=false
HARVEST_FLOW_NAME=Harvest Source

# --- Harvest configuration (base64, one line) ---
# This IS the harvest config: resolved first, before any mounted file (see
# harvester/cde_harvester/core/config.py:resolve_harvest_config_file).
#
# It is base64 rather than raw YAML because a multi-line env value does not
# survive the trip through Coolify's env editor -> generated .env -> compose
# dotenv parser: continuation lines get reindented and `#` comment lines get
# mangled. Base64 is [A-Za-z0-9+/=] on a single line, so there is nothing left
# to corrupt. A value that fails to decode aborts startup rather than silently
# falling back to a stale config.
#
# Generate/regenerate from whichever config file you want to deploy:
#
#     base64 < harvest_config.production.yaml | tr -d '\n'
#
# Inspect what a deployed value actually contains:
#
#     echo "$HARVEST_CONFIG_B64" | base64 -d
#
# The value below is the small two-server set for testing; encode
# harvest_config.production.yaml instead to go wider. On the next redeploy the
# worker re-registers one per-source deployment per erddap_urls entry.
HARVEST_CONFIG_
