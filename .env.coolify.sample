# Coolify environment variables — TEST/STAGING template.
#
# Paste this into the Coolify resource's Environment Variables (use the
# "Developer view" to paste the whole block). Coolify deploys the base
# docker-compose.yaml only (no override, no host ports) and injects the
# SERVICE_FQDN_NGINX_4000 / SERVICE_URL_NGINX magic variables itself — do NOT
# set those here.
#
# The harvest config arrives via HARVEST_CONFIG_YAML below (the image bakes no
# config and repo-file bind mounts don't work under Coolify). Edit it in the
# Coolify UI and REDEPLOY the resource to apply — a container restart is not
# enough to pick up env changes.

# --- Database (internal to the compose stack) ---
DB_NAME=cde
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_HOST=db
DB_HOST_EXTERNAL=db
REDIS_HOST=redis

# --- API / frontend ---
# Public URL of this Coolify resource (nginx FQDN Coolify assigns) + /api.
# Used as a frontend BUILD argument, so changing it requires a rebuild.
API_URL=https://CHANGE-ME.example.coolify/api
BASE_URL=/
CORS_ORIGINS=*
ENABLE_API_DOCS=true

# --- Download scheduler ---
# SERVICE_URL_NGINX (injected by Coolify) already provides the download WAF
# base; DOWNLOAD_WAF_URL is the non-Coolify fallback and can stay unset.
CREATE_PDF=False
DOWNLOADS_FOLDER=./downloads
# GMAIL_USER=
# GMAIL_PASSWORD=

# --- Observability ---
ENVIRONMENT=staging
SENTRY_DSN=

# --- Prefect worker / harvest triggers ---
# No cron while testing — trigger harvests manually from the Prefect UI or the
# dashboard. Set e.g. "0 0 */3 * *" when ready for a schedule (applies on redeploy).
HARVESTER_CRON=
VERNACULARS_CRON=
# Leave false so a config-only redeploy doesn't kick off a harvest.
RUN_ON_DEPLOY=false
REGISTER_DEPLOYMENTS=true
INCREMENTAL_MODE=true

# --- Harvest dashboard ---
# External Prefect UI base URL for "View in Prefect" links.
PREFECT_UI_URL=https://CHANGE-ME-prefect.example.coolify
HARVEST_TRIGGER_ENABLED=false
HARVEST_FLOW_NAME=Harvest Source

# --- Harvest configuration (full YAML, inline) ---
# This IS the harvest config: resolved first, before any mounted file (see
# harvester/cde_harvester/core/config.py:resolve_harvest_config_file). The
# indentation Coolify adds to continuation lines is stripped automatically.
# Small two-server set for testing; extend erddap_urls to go wider. On the
# next redeploy the worker re-registers one per-source deployment per URL.
HARVEST_CONFIG_YAML="erddap_urls:
  - https://catalogue.hakai.org/erddap
  - https://www.smartatlantic.ca/erddap
cache: false
incremental: true
flush_redis: false
log_time: false
folder:
dataset_ids:
# OBIS is omitted for the test config; point obis_datasets_file at
# /app/harvester/Obis_Datasets.json (baked into the image) to include it.
# obis_datasets_file: /app/harvester/Obis_Datasets.json
"
