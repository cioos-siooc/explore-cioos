# Production (self-hosted, non-Coolify). Resolved from 1Password by the deploy
# workflow (op_secret_files: ".env.production:.env").
#
# Only settings that DIFFER from the defaults in docker-compose.yaml belong
# here; see .env.sample for the full list and what each default is.

# --- Compose file selection ---------------------------------------------------
# docker-compose.production.yaml is an OVERLAY: it holds only what production
# adds on top of docker-compose.yaml. Setting COMPOSE_FILE here means every
# docker compose command run in the deploy directory (including ad-hoc ones over
# SSH) layers both files, not just the base.
COMPOSE_FILE=docker-compose.yaml:docker-compose.production.yaml

# --- Public URL + published ports ----------------------------------------------
# Everything that needs an externally-usable link (emailed download links, the
# OpenAPI servers entry) is derived from APP_URL.
APP_URL=https://explore.juno.cioos.ca
NGINX_PORT=8098
# PREFECT_PORT=4200

# --- Database -------------------------------------------------------------------
DB_NAME=op://CIOOS-Infrastructure-Beluga/explore-cioos-production/DB_NAME
DB_USER=op://CIOOS-Infrastructure-Beluga/explore-cioos-production/DB_USER
DB_PASSWORD=op://CIOOS-Infrastructure-Beluga/explore-cioos-production/DB_PASSWORD
# Non-default port; also sets Postgres' internal PGPORT.
DB_PORT=5433
# Host name from OUTSIDE docker: the harvester and any remote prefect_worker run
# outside this compose project and reach Postgres over the VPN.
DB_HOST_EXTERNAL=172.16.61.22
# Interface the db container's port is published on
# (docker-compose.production.yaml). Same address as DB_HOST_EXTERNAL: the VPN
# interface, so Postgres is reachable by the external harvester and by nothing
# else. Unset => 127.0.0.1, which is closed to the outside.
DB_BIND_ADDRESS=172.16.61.22

# --- Web API ---------------------------------------------------------------------
# The SPA calls /api relative to whatever host serves it, so APP_URL above needs
# no counterpart here. Lock CORS to the one public origin (default is "*").
CORS_ORIGINS=https://explore.juno.cioos.ca
ENABLE_API_DOCS=false

# --- Download scheduler ------------------------------------------------------------
CREATE_PDF=True
GMAIL_USER=op://CIOOS-Infrastructure-Beluga/explore-cioos-production/GMAIL_USER
GMAIL_PASSWORD=op://CIOOS-Infrastructure-Beluga/explore-cioos-production/GMAIL_PASSWORD

# --- Observability -------------------------------------------------------------------
ENVIRONMENT=juno-cioos-co-production
SENTRY_DSN=op://CIOOS-Infrastructure-Beluga/explore-cioos-production/SENTRY_DSN
# Fraction of transactions traced, 0.0–1.0 (web-api, runtime). Default 0.1.
# SENTRY_TRACES_SAMPLE_RATE=0.1
# Sourcemap upload + release tagging in the frontend build. Leave
# SENTRY_AUTH_TOKEN unset to skip upload entirely.
# SENTRY_RELEASE=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# --- Harvester ---------------------------------------------------------------------------
INCREMENTAL_MODE=true
# No recurring schedule here: harvests are triggered from the Prefect UI.
HARVESTER_CRON=
# VERNACULARS_CRON=
# RUN_ON_DEPLOY=false

# --- Consumed by the separate harvest-dashboard service, not by this stack ------------------
# PREFECT_UI_URL=
# HARVEST_TRIGGER_ENABLED=false
# HARVEST_FLOW_NAME=Harvest Source
