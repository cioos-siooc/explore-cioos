# Local development needs NOTHING here except DB_PASSWORD: every other setting
# has a working default in docker-compose.yaml, and the ones that describe the
# site are derived from APP_URL / NGINX_PORT below.
#
#   ./scripts/init-dev-env.sh && docker compose up -d
#
# Everything commented out is an override, not a requirement. Uncomment a line
# only when the default is wrong for your deployment.

# =============================================================================
# The two settings a deployment actually configures
# =============================================================================

# Public URL of the site. Used wherever a link has to work from OUTSIDE the
# compose network: emailed download links and the OpenAPI "servers" entry.
# Unset => http://localhost:${NGINX_PORT}. Under Coolify, leave it unset —
# SERVICE_URL_NGINX is injected with the generated FQDN and wins over this.
# APP_URL=https://explore.cioos.ca

# Host port nginx is published on, by docker-compose.override.yaml (local) and
# docker-compose.production.yaml. The base file publishes no host ports at all,
# so Coolify can route to container port 4000 over its own network.
NGINX_PORT=8098
# PREFECT_PORT=4200   # Prefect UI/API, published by the same two files

# =============================================================================
# Database
# =============================================================================
# The only value with no default: docker-compose.production.yaml PUBLISHES this
# port on the host, so a default would be a real credential committed to git.
# Change it for anything that is not a throwaway local stack.
DB_PASSWORD=password
# DB_NAME=cde         # default
# DB_USER=postgres    # default
# DB_PORT=5432        # default; also sets Postgres' internal PGPORT
#
# DB_HOST / DB_HOST_EXTERNAL / REDIS_HOST are NOT listed: compose pins them to
# the service names (db, redis) for every service that connects, so a value here
# would be ignored. Set them only when running a component outside compose.
#
# Production only (docker-compose.production.yaml), where the db port is
# published: the interface to publish it on. Unset => 127.0.0.1, i.e. closed.
# DB_BIND_ADDRESS=

# =============================================================================
# Redis
# =============================================================================
# Only needed when redis is somewhere else (managed instance, auth, TLS);
# REDIS_URL wins over host/port. The API (web-api/utils/redis.js) and the
# harvester's cache invalidator (cde_harvester/redisFunctions.py) read the same
# four, so both halves of the cache always land on one instance.
#REDIS_URL=
#REDIS_PORT=6379
#REDIS_PASSWORD=
#REDIS_TLS=false

# Cache warm-up, run by the harvester after a load that changed data: it
# replays the most-requested routes from the nginx access log so the site is
# warm before anyone arrives. The base URL stays inside the compose network so
# the warm-up never goes out and back through the WAF.
#CACHE_WARM_BASE_URL=http://nginx:4000
#CACHE_WARM_CONCURRENCY=8

# =============================================================================
# Web API / frontend
# =============================================================================
# The SPA calls the API at the relative path /api, on whatever host serves it,
# so the public URL is NOT baked into the bundle and changing APP_URL needs no
# frontend rebuild. Override only to point the SPA at a different origin — and
# note it is a BUILD argument, so a change means rebuilding the frontend image.
# API_URL=/api
# BASE_URL=/          # sub-path the SPA is served under

# CORS for web-api:
#   *          => allow all origins (the default when unset)
#   disabled   => no CORS middleware (no cross-origin browser access)
#   comma list => explicit allow-list, e.g. https://explore.cioos.ca
# Requests with no Origin header (curl, server-to-server) are always allowed.
# CORS_ORIGINS=*

# Swagger UI + /api/openapi.json. Unset => enabled. When false, both redirect
# to BASE_URL.
# ENABLE_API_DOCS=true

# =============================================================================
# Download scheduler
# =============================================================================
# Emails download links; without credentials it logs instead of sending.
# GMAIL_USER=example@example.com
# GMAIL_PASSWORD=password
# CREATE_PDF=False    # needs wkhtmltopdf; opt-in at image build time

# =============================================================================
# Observability
# =============================================================================
ENVIRONMENT=development
# Setting SENTRY_DSN enables Sentry in both web-api and the browser app; leaving
# it empty disables both. web-api reads it at runtime; the frontend takes it as
# a build arg, so a changed value needs a frontend rebuild, and the value is
# public once built (it ships inside the JS bundle).
SENTRY_DSN=
# Fraction of transactions traced, 0.0–1.0 (web-api, runtime). Default 0.1.
# SENTRY_TRACES_SAMPLE_RATE=1.0
# Sourcemap upload + release tagging in the frontend build. Leave
# SENTRY_AUTH_TOKEN unset to skip upload entirely (local/dev builds).
# SENTRY_RELEASE=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# =============================================================================
# Compose file selection
# =============================================================================
# Local dev needs nothing: a bare `docker compose up` loads docker-compose.yaml
# plus docker-compose.override.yaml automatically. Self-hosted (non-Coolify)
# production layers the production OVERLAY on top — see .env.production:
#   COMPOSE_FILE=docker-compose.yaml:docker-compose.production.yaml

# =============================================================================
# Harvester
# =============================================================================
# Only harvest records new or updated since the last harvest.
INCREMENTAL_MODE=true

# The prefect_worker runs harvest flows IN-PROCESS on a Prefect "process" work
# pool. Scale with: docker compose up -d --scale prefect_worker=N
#
# Recurring full-harvest schedule (cron). Unset/empty = no schedule.
HARVESTER_CRON=0 0 */3 * *
# Recurring WoRMS vernaculars backfill schedule (cron). Unset/empty = none.
# VERNACULARS_CRON=
# Fire ONE full harvest on each (re)deploy:
#   false (default) = never; true/once = only when the DB is empty; always
# RUN_ON_DEPLOY=false
# REGISTER_DEPLOYMENTS is not listed: both compose files pin it on the service
# (true in docker-compose.yaml, false in docker-compose.worker.yaml), so a value
# here is ignored. It matters only when running worker-entrypoint.sh by hand.
# Concurrent flow runs, budgeted against HARVESTER_MEM_LIMIT — each run is a
# separate pandas working set. Defaults: 2 runs, 6g.
# HARVEST_WORKER_LIMIT=2
# HARVESTER_MEM_LIMIT=6g

# --- Harvest configuration ---
# The image bakes NO harvest config; the worker resolves one at runtime in
# priority order (see harvester/cde_harvester/core/config.py):
#   1. HARVEST_CONFIG_B64   — the whole YAML file, base64-encoded on ONE line
#      (Coolify; see .env.coolify.sample). Generate/regenerate with:
#          base64 < harvest_config.yaml | tr -d '\n'
#      It is base64 rather than raw YAML because multi-line env values do not
#      survive Coolify's env editor intact (reindented continuations, mangled
#      `#` comments). A bad value fails startup loudly; it never silently falls
#      back to a stale mounted file.
#   2. HARVEST_CONFIG_FILE  — container path to a mounted config file (the
#      compose files already set this to /app/harvester/harvest_config.yaml)
#   3. a file mounted at /app/harvester/harvest_config.yaml
# Locally, mount ./harvest_config.yaml via docker-compose.override.yaml instead
# of setting anything here. Do NOT set HARVEST_CONFIG_FILE to a host path — it
# is resolved INSIDE the container.
# HARVEST_CONFIG_B64=
# HARVEST_CONFIG_FILE=

# =============================================================================
# Consumed by the separate harvest-dashboard service, NOT by this stack.
# Kept here because that service is deployed from the same environment.
# =============================================================================
# PREFECT_UI_URL=https://prefect-obis.cool.beluga.cioos.ca
# HARVEST_TRIGGER_ENABLED=false
# HARVEST_FLOW_NAME=Harvest Source
