# Staging and beta (self-hosted on Juno, host cioos-co-dev-explore / 172.16.61.26,
# 2 CPU / 8 GB). One stack serves both, one deploy at a time.
# Resolved from 1Password by the release deploy workflow
# (op_secret_files: ".env.staging:.env").
#
# Create the `explore-cioos-staging` item in the CIOOS-Infrastructure-Juno
# vault with the fields referenced below before publishing a beta or rc release.

COMPOSE_FILE=docker-compose.yaml:docker-compose.production.yaml
HARVEST_CONFIG_HOST_FILE=./harvest_config.production.yaml

# --- Public service and database isolation -----------------------------------
APP_URL=https://dev.explore.cioos.ca
# Must match the dev.explore.cioos.ca upstream in the Juno infra repo's
# services-manifest.yml proxy_routes (172.16.61.26:8098).
NGINX_PORT=8098
PREFECT_PORT=op://CIOOS-Infrastructure-Juno/explore-cioos-staging/PREFECT_PORT
DB_NAME=op://CIOOS-Infrastructure-Juno/explore-cioos-staging/DB_NAME
DB_USER=op://CIOOS-Infrastructure-Juno/explore-cioos-staging/DB_USER
DB_PASSWORD=op://CIOOS-Infrastructure-Juno/explore-cioos-staging/DB_PASSWORD
DB_PORT=op://CIOOS-Infrastructure-Juno/explore-cioos-staging/DB_PORT
DB_HOST_EXTERNAL=172.16.61.26
DB_BIND_ADDRESS=172.16.61.26

# --- API and scheduler --------------------------------------------------------
CORS_ORIGINS=https://dev.explore.cioos.ca
ENABLE_API_DOCS=true
CREATE_PDF=False
GMAIL_USER=op://CIOOS-Infrastructure-Juno/explore-cioos-staging/GMAIL_USER
GMAIL_PASSWORD=op://CIOOS-Infrastructure-Juno/explore-cioos-staging/GMAIL_PASSWORD

# --- Observability ------------------------------------------------------------
ENVIRONMENT=juno-cioos-co-staging
SENTRY_DSN=op://CIOOS-Infrastructure-Juno/explore-cioos-staging/SENTRY_DSN
# Sourcemap upload (readable stack traces); SENTRY_RELEASE is set per tag by
# the deploy workflow.
SENTRY_AUTH_TOKEN=op://CIOOS-Infrastructure-Juno/explore-cioos-staging/SENTRY_AUTH_TOKEN
SENTRY_ORG=cioos
SENTRY_PROJECT=4508654137376768

# --- Harvester ----------------------------------------------------------------
INCREMENTAL_MODE=true
HARVESTER_CRON=0 0 */3 * * # every 3 days at midnight
VERNACULARS_CRON=0 0 * * 0 # weekly
RUN_ON_DEPLOY=true # a new tag starts on an empty database
HARVESTER_MEM_LIMIT=3g
