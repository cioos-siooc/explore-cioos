# Staging (self-hosted on Juno). Resolved from 1Password by the release deploy
# workflow (op_secret_files: ".env.staging.sample:.env"). Keep every
# Juno-specific value here so staging cannot share production's ports, database,
# or URL.
#
# Create the `explore-cioos-staging` item in the CIOOS-Infrastructure-Beluga
# vault with the fields referenced below before publishing a prerelease.

COMPOSE_FILE=docker-compose.yaml:docker-compose.production.yaml
COMPOSE_NETWORK_NAME=explore-cioos-staging_default
HARVEST_CONFIG_HOST_FILE=./harvest_config.sample.yaml

# --- Public service and database isolation -----------------------------------
APP_URL=op://CIOOS-Infrastructure-Beluga/explore-cioos-staging/APP_URL
NGINX_PORT=op://CIOOS-Infrastructure-Beluga/explore-cioos-staging/NGINX_PORT
PREFECT_PORT=op://CIOOS-Infrastructure-Beluga/explore-cioos-staging/PREFECT_PORT
DB_NAME=op://CIOOS-Infrastructure-Beluga/explore-cioos-staging/DB_NAME
DB_USER=op://CIOOS-Infrastructure-Beluga/explore-cioos-staging/DB_USER
DB_PASSWORD=op://CIOOS-Infrastructure-Beluga/explore-cioos-staging/DB_PASSWORD
DB_PORT=op://CIOOS-Infrastructure-Beluga/explore-cioos-staging/DB_PORT
DB_HOST_EXTERNAL=op://CIOOS-Infrastructure-Beluga/explore-cioos-staging/DB_HOST_EXTERNAL
DB_BIND_ADDRESS=op://CIOOS-Infrastructure-Beluga/explore-cioos-staging/DB_BIND_ADDRESS

# --- API and scheduler --------------------------------------------------------
CORS_ORIGINS=op://CIOOS-Infrastructure-Beluga/explore-cioos-staging/CORS_ORIGINS
ENABLE_API_DOCS=true
CREATE_PDF=False
GMAIL_USER=op://CIOOS-Infrastructure-Beluga/explore-cioos-staging/GMAIL_USER
GMAIL_PASSWORD=op://CIOOS-Infrastructure-Beluga/explore-cioos-staging/GMAIL_PASSWORD

# --- Observability ------------------------------------------------------------
ENVIRONMENT=juno-cioos-co-staging
SENTRY_DSN=op://CIOOS-Infrastructure-Beluga/explore-cioos-staging/SENTRY_DSN

# --- Harvester ----------------------------------------------------------------
INCREMENTAL_MODE=true
HARVESTER_CRON=
VERNACULARS_CRON=
RUN_ON_DEPLOY=false
