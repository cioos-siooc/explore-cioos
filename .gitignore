# Environment files. `*.env` matched `.env` and `foo.env` but not the
# `.env.<name>` family, so a new per-environment file (`.env.local`,
# `.env.staging`) could be committed with no warning. Ignore the family and
# allow back the ones that are deliberately tracked: the samples, and the two
# templated files whose secrets are `op://` 1Password refs resolved at deploy
# (deploy.yml `op_secret_files`) rather than literals.
*.env
.env.*
!.env.sample
!.env.coolify.sample
!.env.production
!*/.env.sample
!frontend/.env.development
docker-compose.override.yaml
.ipynb_checkpoints
*.ipynb
harvester_cache
ckan_harvester_cache
build
*.csv
!harvester/**/*.csv
harvest
harvester_cache*
harvest_config.yaml

cache.zip~
ceda_log
erddap_scraper_dc.zip
out1
log

most_common_queries

nginx/logs/
nginx/logrotate_state/
nginx/logs/*.log
harvester_logs
# The downloaded OBIS occurrence caches. Anchored with a leading slash: a bare
# `obis/` matches a directory of that name at ANY depth, which also swallowed
# the source package at harvester/cde_harvester/sources/obis/ and kept
# discovery.py out of the repo while its tests were committed.
/obis/
/harvester/obis/

# Claude Code config. `settings.json` and `hooks/` are shared with the team;
# these two are not. `.claude/worktrees/` holds full checkouts created by the
# worktree tool, so leaving it trackable makes `git add -A` commit gitlinks.
.claude/worktrees/
.claude/settings.local.json

# Tool caches. Each of these ships its own generated `.gitignore`, which is not
# ours to rely on — a cache created by an older tool version has none.
.pytest_cache/
.ruff_cache/

# Harvest and download outputs. harvest-prod/ (96 MB) was invisible only
# because the blanket `*.csv` above swallowed its contents.
harvest-prod/
harvest_obis*/

# The OBIS occurrence cache written by a local harvest — 1 GB after one full
# discovery run, and `obis_cache` is the DEFAULT folder name, so it lands
# wherever the harvester is invoked from rather than at a fixed path.
obis_cache*/

# memory_profiler output and harvest logs from a profiled run.
*.dat
*.mprof
obis_harvest*.log
obis_harvest*.png

# downloads/ is a tracked mount point (README.md explains it); ignore only the
# generated archives inside it.
/downloads/*
!/downloads/README.md
