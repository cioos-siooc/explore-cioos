# Local-dev host port publishing.
#
# The base docker-compose.yaml intentionally does NOT publish host ports, so
# Coolify's single-file deploy (docker compose -f docker-compose.yaml up) routes
# everything through its proxy without binding/colliding on host ports.
#
# For standalone local development, copy this file to docker-compose.override.yaml
# (gitignored). A bare `docker compose up` auto-loads docker-compose.override.yaml
# on top of the base, restoring host access to nginx / prefect. Coolify never
# loads it because it deploys with an explicit `-f docker-compose.yaml`.
#
# Ports are tunable via NGINX_PORT / PREFECT_PORT in .env. The db host port is
# published only in production (docker-compose.production.yaml); locally use
# `docker compose exec db psql ...`, or add a db ports mapping here if needed.
#
#   cp docker-compose.override.yaml.sample docker-compose.override.yaml
#   docker compose up -d
services:
  nginx:
    ports:
      - "${NGINX_PORT:-8098}:4000"
  prefect:
    ports:
      - "${PREFECT_PORT:-4200}:4200"  # Prefect UI + API
  prefect_worker:
    # Mount your local harvest config — the image does not bake one, so without
    # this mount (or a HARVEST_CONFIG_B64 env var) the worker refuses to start.
    # Create it first: `cp harvest_config.sample.yaml harvest_config.yaml`
    # (harvest_config.yaml is gitignored). Edits are picked up on the next flow
    # run; a changed server list needs `docker compose restart prefect_worker`
    # to re-register the per-source deployments.
    volumes:
      - ./harvest_config.yaml:/app/harvester/harvest_config.yaml:ro

# Optional: make the base stack's `source_cache` volume host-wide instead of
# Compose-project-scoped. This is useful when several local/dev instances run
# on the same Docker host. Create it once first:
#
#   docker volume create cde-dev-source-cache
#
# Then set HARVEST_SOURCE_CACHE_VOLUME=cde-dev-source-cache in `.env` (or
# export it before `docker compose up`). This sample is not loaded by Coolify;
# set the same variable in each Coolify resource instead.
#
# volumes:
#   source_cache:
#     name: ${HARVEST_SOURCE_CACHE_VOLUME:-cde-dev-source-cache}
