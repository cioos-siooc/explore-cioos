# Dev-server defaults (vite). /api is proxied to the docker-compose stack by
# server.proxy in vite.config.mjs — see README "Option 1".
# For a remote API (README "Option 2"), override on the command line:
#   API_URL=https://explore.cioos.ca/api npm run dev
# For a local stack on a non-default port, override the proxy target instead:
#   DEV_API_PROXY_TARGET=http://localhost:9000 npm run dev
API_URL=/api
