# Test-mode defaults, loaded by vite's loadEnv for both `vitest` (mode 'test')
# and `vite --mode test`, which is what the Playwright webServer runs.
#
# api.test is a reserved TLD that cannot resolve. That is the point: every API
# call in the e2e suite is answered by the mock router in e2e/fixtures/mockApi.js,
# and anything that escapes it fails loudly instead of quietly reaching the real
# https://explore.cioos.ca/api that .env.development points at.
API_URL=http://api.test/api
BASE_URL=/
ENVIRONMENT=test
