  "name": "cioos-data-explorer",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "homepage": "https://explore.cioos.ca/",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/quicksand": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "@mapbox/mapbox-gl-draw": "^1.5.2",
    "@sentry/react": "^11.8.0",
    "@turf/bbox": "^7.4.0",
    "@turf/bbox-polygon": "^7.4.0",
    "@turf/buffer": "^7.4.0",
    "@turf/distance": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/points-within-polygon": "^7.4.0",
    "@turf/simplify": "^7.4.0",
    "@turf/union": "^7.4.0",
    "bytes": "^3.1.2",
    "classnames": "^2.5.1",
    "d3-scale": "^4.0.2",
    "fuse.js": "^7.5.0",
    "i18next": "^26.5.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "lodash-es": "^4.18.1",
    "mapbox-gl-draw-rectangle-mode": "^1.0.4",
    "maplibre-gl": "^6.15.0",
    "marked": "^18.1.1",
    "mermaid": "^12.2.0",
    "plotly.js": "^4.1.2",
    "plotly.js-basic-dist-min": "^4.1.2",
    "plotly.js-locales": "^4.1.2",
    "prop-types": "^15.8.1",
    "react": "19.3.1",
    "react-bootstrap-icons": "^1.11.6",
    "react-data-table-component": "^8.12.0",
    "react-dom": "19.3.1",
    "react-i18next": "^17.1.3",
    "react-plotly.js": "^4.1.0",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@maplibre/geojson-vt": "^6.3.0",
    "@maplibre/maplibre-gl-style-spec": "^26.4.4",
    "@maplibre/vt-pbf": "^4.3.2",
    "@playwright/test": "1.64.1",
    "@sentry/vite-plugin": "^11.8.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "rollup-plugin-visualizer": "^7.1.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "test": "vitest run && npm run test:node",
    "dev": "vite",
    "start": "vite --open",
    "build": "vite build",
    "build:analyze": "ANALYZE=1 vite build",
    "preview": "vite preview",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage && npm run test:node",
    "test:node": "node --test $(find src -name '*.test.mjs')",
    "test:e2e": "playwright test --project=desktop --project=tablet --project=mobile",
    "test:visual": "e2e/in-container.sh test --project=visual",
    "test:visual:update": "e2e/in-container.sh test --project=visual --update-snapshots",
    "test:a11y": "e2e/in-container.sh test --project=a11y",
    "test:a11y:baseline": "A11Y_BASELINE=record e2e/in-container.sh test --project=a11y",
    "test:all": "npm run test && e2e/in-container.sh test",
    "dev:test": "vite --mode test",
    "test:e2e:live": "LIVE_BASE_URL=${LIVE_BASE_URL:-http://localhost:8098} playwright test --project=live",
    "test:e2e:record": "node e2e/record-fixtures.mjs",
    "test:e2e:update": "npm run test:e2e:record && npm run test:visual:update && npm run test:a11y:baseline"
  },
  "author": "",
  "license": "ISC"
}
