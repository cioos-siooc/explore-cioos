    "@turf/bbox": "^6.5.0",
    "@turf/bbox-polygon": "^6.5.0",
    "@turf/points-within-polygon": "^6.5.0",
    "@turf/union": "^6.5.0",
    "bytes": "^3.1.2",
    "classnames": "^2.5.1",
    "d3-scale": "^4.0.2",
    "i18next": "^25.10.10",
    "i18next-browser-languagedetector": "^8.2.1",
    "lodash": "^4.17.21",
    "mapbox-gl-draw-rectangle-mode": "^1.0.4",
    "maplibre-gl": "^5.24.0",
    "plotly.js-basic-dist-min": "^3.0.0",
    "plotly.js-locales": "^3.0.0",
    "prop-types": "^15.8.1",
    "react": "18.3.1",
    "react-bootstrap-icons": "^1.11.6",
    "react-data-table-component": "^7.7.1",
    "react-dom": "18.3.1",
    "react-i18next": "^16.6.6",
    "react-plotly.js": "^2.6.0",
    "react-router-dom": "^6.30.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.62.1",
    "@sentry/vite-plugin": "^5.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^8.16.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-config-standard": "^17.0.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-promise": "^6.0.0",
    "eslint-plugin-react": "^7.30.0",
    "eslint-plugin-standard": "^4.1.0",
    "jsdom": "^30.0.1",
    "prettier": "^2.7.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "vite": "^7.0.0",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "start": "vite --open",
    "build": "vite build",
    "build:analyze": "ANALYZE=1 vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .js,.jsx --ignore-path .gitignore",
    "lint:fix": "eslint --fix . --ext .js,.jsx --ignore-path .gitignore",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=e2e",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "test:a11y": "playwright test --project=a11y",
    "test:all": "npm run test && playwright test",
    "dev:test": "vite --mode test",
    "test:a11y:baseline": "A11Y_BASELINE=record playwright test --project=a11y",
    "test:e2e:live": "LIVE_BASE_URL=${LIVE_BASE_URL:-http://localhost:8098} playwright test --project=live",
    "test:e2e:record": "node e2e/record-fixtures.mjs"
  },
  "author": "",
  "license": "ISC",
  "overrides": {},
  "allowScripts": {
    "esbuild@0.28.1": true,
    "maplibre-gl@4.7.1": true,
    "es5-ext@0.10.64": true,
    "maplibre-gl@5.24.0": true
  }
}
