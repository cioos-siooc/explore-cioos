DB_USER=postgres
DB_PASSWORD=password
DB_NAME=cde
# DB_HOST_EXTERNAL is preferred and DB_HOST is the fallback (cde_common/db.py);
# either name works. Defaults to localhost when neither is set.
DB_HOST=localhost
# DB_PORT=5432
SENTRY_DSN=sentry_dsn
ENVIRONMENT=development
# Fraction of transactions Sentry traces, 0.0-1.0. Defaults to 1.0.
# SENTRY_TRACES_SAMPLE_RATE=1.0

# Redis, used by redisFunctions.py to drop and re-warm the API cache after a
# load that changed data. Must point at the SAME instance web-api fills (see
# web-api/.env.sample) or the harvest flushes a cache nobody is reading.
# REDIS_URL wins over host/port when set. `redis` is the compose service name —
# use localhost only when running against a redis on the host.
REDIS_HOST=redis
#REDIS_URL=
#REDIS_PORT=6379
#REDIS_PASSWORD=
#REDIS_TLS=false

# Where the warm-up replays the most-requested routes from the nginx access
# log. Defaults to the compose service, so the warm-up stays on the internal
# network instead of going out through the WAF.
#CACHE_WARM_BASE_URL=http://nginx:4000
#CACHE_WARM_CONCURRENCY=8

# Set to 0/false to skip prune_stale_datasets() on incremental loads.
#CDE_PRUNE_STALE=1
