# These values could also come in via docker compose file, that would have priority
DB_NAME=cde
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=localhost

# Redis, read by utils/redis.js. REDIS_URL wins over host/port. The harvester's
# invalidator (cde_harvester/redisFunctions.py) reads the same variables: point
# both at the same instance. Use localhost only when running web-api on the host.
REDIS_HOST=redis
#REDIS_URL=
#REDIS_PORT=6379
#REDIS_PASSWORD=
#REDIS_TLS=false

# CORS configuration:
# *            => allow all origins
# disabled     => disable CORS middleware entirely
# comma list   => allow only those origins (no spaces):
#                  CORS_ORIGINS=https://explore.cioos.ca,https://staging.explore.cioos.ca
CORS_ORIGINS=*

# API Documentation configuration:
# true         => enable Swagger UI and OpenAPI docs (default)
# false        => disable API documentation endpoints (redirects to BASE_URL)
ENABLE_API_DOCS=true
