# These values could also come in via docker compose file, that would have priority
DB_NAME=cde
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=localhost

# Redis, read by utils/redis.js. Only REDIS_HOST is usually needed; REDIS_URL
# wins over host/port when set, and the other three are for a redis that isn't
# a local unauthenticated one. The harvester's cache invalidator
# (cde_harvester/redisFunctions.py) reads the same four — point both at the
# same instance, or a harvest will flush a cache the API isn't using.
# `redis` is the compose service name and the default; set localhost only when
# running web-api on the host against a redis there.
REDIS_HOST=redis
#REDIS_URL=
#REDIS_PORT=6379
#REDIS_PASSWORD=
#REDIS_TLS=false

# CORS configuration:
# *            => allow all origins
# disabled     => disable CORS middleware entirely
# comma list   => allow only those origins (no spaces):
#                  CORS_ORIGINS=https://explore.cioos.ca,https://staging.explore.cioos.ca
CORS_ORIGINS=*

# API Documentation configuration:
# true         => enable Swagger UI and OpenAPI docs (default)
# false        => disable API documentation endpoints (redirects to BASE_URL)
ENABLE_API_DOCS=true
