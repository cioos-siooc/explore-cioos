{
  "name": "cde-web-api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node ./bin/www",
    "test": "npm run test:unit && npm run test:routes && npm run test:contract",
    "test:unit": "node --test \"utils/**/*.test.js\"",
    "test:routes": "node --test --test-force-exit \"routes/**/*.test.js\"",
    "test:contract": "jest",
    "test:api": "npm run test:contract",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@sentry/node": "^11.8.0",
    "apicache": "1.6.3",
    "axios": "1.20.0",
    "cors": "^2.8.6",
    "debug": "^4.4.1",
    "dotenv": "^18.0.9",
    "express": "5.3.0",
    "express-validator": "^7.3.2",
    "http-errors": "^2.0.0",
    "knex": "3.3.0",
    "morgan": "1.12.1",
    "pg": "^8.23.1",
    "pg-parse-float": "^0.0.1",
    "redis": "6.3.0",
    "sharp": "^0.35.5",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.0",
    "wkt": "^0.1.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "setupFiles": [
      "<rootDir>/__tests__/setup.js"
    ]
  }
}
